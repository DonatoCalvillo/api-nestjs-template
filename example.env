# Environment
NODE_ENV=development|production|test
PORT=3000

# Database (use 5433 if you have local Postgres on 5432, e.g. Homebrew)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=postgres
# DB_SSL=true
# DB_POOL_MAX=20
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_MIGRATIONS_RUN=false  # opt-in true in containers; alternative: pnpm migration:run

# Authentication (JWT + password hashing)
# Production: JWT_*_SECRET required, minimum 32 characters
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# API documentation (Swagger at /api/docs)
# Defaults to true in development, false in production
SWAGGER_ENABLED=true

# Idempotency (safe retries via Idempotency-Key header on mutating requests)
# See docs/idempotency.md
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_CLEANUP_CRON="0 */6 * * *"

# Security - CORS
CORS_ENABLED=true
CORS_ORIGINS=*
CORS_CREDENTIALS=false

# Security - HTTP headers (Helmet)
HELMET_ENABLED=true

# Security - Rate limiting
THROTTLE_ENABLED=true
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_STORAGE=memory

# Multi-instance coordination (Redis)
# REDIS_URL=redis://localhost:6379
OUTBOX_RELAY_LOCK=memory
OUTBOX_RELAY_LOCK_TTL_SECONDS=120

# Outbox relay (publish domain events to external broker)
# See docs/domain-events.md
OUTBOX_RELAY_ENABLED=false
OUTBOX_RELAY_CRON="*/5 * * * * *"
OUTBOX_RELAY_BATCH_SIZE=50
OUTBOX_RELAY_MAX_ATTEMPTS=5

# Security - IP filtering (allowlist)
IP_FILTER_ENABLED=false
IP_ALLOWLIST=127.0.0.1,::1
TRUST_PROXY=false

# HTTP Resilience - outbound API calls
HTTP_RESILIENCE_ENABLED=true
HTTP_TIMEOUT_MS=5000
HTTP_RETRY_MAX_ATTEMPTS=3
HTTP_RETRY_DELAY_MS=500
HTTP_RETRY_BACKOFF_MULTIPLIER=2
HTTP_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
HTTP_CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

# HTTP - inbound limits
# HTTP_BODY_LIMIT=1mb
# HTTP_REQUEST_TIMEOUT_MS=30000

# Graceful shutdown (max wait for in-flight requests before force exit)
SHUTDOWN_DRAIN_TIMEOUT_MS=30000

# Logging (LOG_LEVEL applies in production JSON mode; dev uses pino-pretty)
# Valid values: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# OpenTelemetry - distributed tracing
OTEL_TRACES_ENABLED=true
OTEL_SERVICE_NAME=dodo-schedule-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Prometheus - metrics
METRICS_ENABLED=true
# METRICS_IP_FILTER_ENABLED=true  # defaults to true in production
METRICS_IP_ALLOWLIST=127.0.0.1,::1
# Add Prometheus/Grafana scraper IPs or pod CIDRs in production/K8s

# Health checks (Terminus)
HEALTH_DISK_PATH=/
HEALTH_DISK_THRESHOLD_PERCENT=0.9
