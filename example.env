# Environment
NODE_ENV=development|production|test
PORT=3000

# Database (use 5433 if you have local Postgres on 5432, e.g. Homebrew)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=postgres

# Security - CORS
CORS_ENABLED=true
CORS_ORIGINS=*
CORS_CREDENTIALS=false

# Security - Rate limiting
THROTTLE_ENABLED=true
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Security - IP filtering (allowlist)
IP_FILTER_ENABLED=false
IP_ALLOWLIST=127.0.0.1,::1
TRUST_PROXY=false
