NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=dodo_schedule

JWT_ACCESS_SECRET=change-me-to-a-secure-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-secure-secret-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

SWAGGER_ENABLED=true
