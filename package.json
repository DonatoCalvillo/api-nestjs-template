{
  "name": "nestjs-api-template",
  "version": "0.0.1",
  "description": "",
  "author": "Donato Calvillo",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest --selectProjects unit",
    "test:related": "jest --selectProjects unit --bail --findRelatedTests --passWithNoTests",
    "test:watch": "jest --selectProjects unit --watch",
    "test:cov": "jest --selectProjects unit --coverage",
    "test:e2e": "pnpm run build && jest --selectProjects e2e --runInBand",
    "test:integration": "pnpm run build && jest --selectProjects integration --runInBand",
    "test:contract": "pnpm run build && jest --selectProjects contract --runInBand",
    "test:all": "pnpm run build && jest --runInBand",
    "test:load": "k6 run load/scenarios/health-live.js",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "prepare": "husky",
    "typeorm": "pnpm run build && npx typeorm",
    "migration:generate": "pnpm run typeorm migration:generate -d dist/database/data-source.js",
    "migration:run": "pnpm run typeorm migration:run -d dist/database/data-source.js",
    "migration:revert": "pnpm run typeorm migration:revert -d dist/database/data-source.js",
    "migration:show": "pnpm run typeorm migration:show -d dist/database/data-source.js",
    "seed:rbac": "pnpm run build && node dist/database/seeds/run-seed-rbac.js",
    "deps:check-age": "node scripts/find-safe-versions.mjs 7",
    "audit:ci": "pnpm audit --audit-level=high"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1064.0",
    "@aws-sdk/s3-request-presigner": "^3.1070.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "11.1.24",
    "@nestjs/core": "11.1.24",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "11.1.24",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "11.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "axios": "^1.17.0",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.8",
    "cache-manager-ioredis-yet": "^2.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "dotenv": "17.4.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "joi": "18.2.1",
    "nestjs-cls": "^6.2.1",
    "nestjs-pino": "4.6.1",
    "nestjs-resilience": "^3.1.2",
    "openid-client": "^6.8.4",
    "otplib": "^13.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "8.21.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.30",
    "value-object-lib": "^1.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@eslint/js": "9.39.4",
    "@nestjs/cli": "11.0.21",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.24",
    "@testcontainers/postgresql": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "25.9.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "7.2.0",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "lint-staged": "17.0.7",
    "prettier": "3.8.3",
    "supertest": "7.2.2",
    "testcontainers": "^12.0.1",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4"
  }
}
